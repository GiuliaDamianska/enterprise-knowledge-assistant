# Anthropic API — used for Claude (question answering)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Voyage AI — used for text embeddings
# Anthropic does not currently offer a standalone embeddings API endpoint.
# Voyage AI is Anthropic's recommended embeddings provider.
# Get your key at https://dash.voyageai.com
VOYAGE_API_KEY=your_voyage_api_key_here

# Directory containing documents to ingest and serve
# Use an absolute path to avoid ambiguity
DOCS_DIR=/absolute/path/to/your/docs

# Local ChromaDB storage path (relative to project root or absolute)
CHROMA_DB_PATH=./chroma_db

# Audit log output path (relative to project root or absolute)
LOG_PATH=./logs/audit.log

# Claude model to use for answering questions
# Default: claude-opus-4-6 (most capable)
CLAUDE_MODEL=claude-opus-4-6
